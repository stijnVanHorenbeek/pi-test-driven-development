{
  "name": "pi-test-driven-development",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "Risk-based test-driven development skill for Pi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stijnVanHorenbeek/pi-test-driven-development.git"
  },
  "homepage": "https://github.com/stijnVanHorenbeek/pi-test-driven-development#readme",
  "bugs": {
    "url": "https://github.com/stijnVanHorenbeek/pi-test-driven-development/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-skill",
    "test-driven-development",
    "testing",
    "tdd",
    "tests"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "eval": "tsx evals/run-evals.ts",
    "eval:report": "tsx evals/run-evals.ts --report-only"
  },
  "files": [
    "skills",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "pi": {
    "skills": [
      "./skills"
    ]
  }
}
